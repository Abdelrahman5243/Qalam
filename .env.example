NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Viewer (read-only) token. Required for Visual Editing: Content Lake only
# returns the Content Source Maps that stega needs on authenticated requests,
# and the drafts perspective needs it too.
# Manage at https://www.sanity.io/manage/personal_access_tokens
SANITY_API_READ_TOKEN=

# Only needed when the Studio is hosted somewhere other than the app itself.
NEXT_PUBLIC_SANITY_STUDIO_URL=
NEXT_PUBLIC_SANITY_PREVIEW_URL=

# Optional analytics IDs. Set different values per Vercel Preview and Production environments.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
